<Window x:Class="RaUI.View.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理旧日志" Width="640" Height="560"
        WindowStartupLocation="CenterOwner" Background="#FF1B1B1B">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="按配置分组清理" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="“清理”只是把整份日志挪进 logs\_archive\时间戳\，索引同步收窄，随时能在归档目录里找回；真要删空间，去归档目录整夹删除。已勾选的是自动判定为可清的：旧构建的轮次（开环数字不可用）和一次都没点的空轮。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupList"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="Result" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnAll" Content="全选 / 全不选" MinHeight="30" Click="OnToggleAll"/>
                <Button x:Name="BtnArchive" Content="归档所选" Style="{StaticResource AccentButton}"
                        MinHeight="30" MinWidth="120" Margin="8,0,0,0" Click="OnArchive"/>
                <Button Content="关闭" MinHeight="30" Margin="8,0,0,0" Click="OnClose"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
