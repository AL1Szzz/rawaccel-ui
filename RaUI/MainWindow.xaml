<Window x:Class="RaUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Raw Accel · Modern UI"
        Width="1220" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="-1"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="8" Background="#CC1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== title bar ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Raw Accel" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Modern UI" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Style="{StaticResource IconButton}" Click="OnMinimize">
                        <Path Data="M0,0 H11" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource IconButton}" Click="OnMaximize">
                        <Path Data="M0,0 H10 V10 H0 Z" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Click="OnClose">
                        <Path x:Name="CloseX" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== body ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Nav" Grid.Column="0" Margin="10,4,6,4" SelectedIndex="0"
                         SelectionChanged="OnNav" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                <Path Data="M1,15 L6,8 L10,11 L17,2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M1,1 H17" Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1"/>
                            </Canvas>
                            <TextBlock Text="曲线与参数" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                <Path Data="M9,1.5 C5.4,1.5 3,4 3,7.5 L3,10.5 C3,14 5.4,16.5 9,16.5 C12.6,16.5 15,14 15,10.5 L15,7.5 C15,4 12.6,1.5 9,1.5 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                <Path Data="M9,4 V8" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                            </Canvas>
                            <TextBlock Text="设备" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18">
                                <Ellipse Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                <Ellipse Width="8" Height="8" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                <Ellipse Width="2.6" Height="2.6" Fill="{StaticResource AccentBrush}"/>
                            </Grid>
                            <TextBlock Text="瞄准测试" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                <Path Data="M1,5.5 H17 M1,12.5 H17" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="2.8" Width="5.4" Height="5.4" Fill="{StaticResource CardBrush}"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="9.8" Width="5.4" Height="5.4" Fill="{StaticResource CardBrush}"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                            </Canvas>
                            <TextBlock Text="设置" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <ContentControl x:Name="Host" Grid.Column="1" Margin="6,4,12,4"/>
            </Grid>

            <!-- ===== status bar ===== -->
            <Border Grid.Row="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DriverText" Grid.Column="1" Text="驱动" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StatusText" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnReload" Content="从驱动读取" Click="OnReload" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSave" Content="保存文件" Click="OnSave"/>
                        <Button x:Name="BtnWrite" Content="写入驱动" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnWrite"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
