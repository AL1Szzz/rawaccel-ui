<UserControl x:Class="RaUI.View.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,6,4,10">
            <StackPanel>
                <TextBlock Text="设备" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Name="Hint" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="填对每只鼠标的真实 DPI，加速阈值就会按物理速度对齐；不填则单位是 counts/ms，换鼠标等于换手感。"/>
            </StackPanel>
            <Button x:Name="BtnRefresh" Content="重新枚举设备" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefresh"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Panel" Margin="4,0,8,0" MaxWidth="860" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
