<UserControl x:Class="RaUI.View.CurvePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RaUI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="4,6,4,10">
            <TextBlock Text="曲线与参数" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"
                       Text="左边是这条曲线长什么样，右边是参数。每个参数名悬停都有解释；只显示当前模式真正会用到的那些，其余的收在「高级」里。"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>

            <!-- chart -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <RadioButton x:Name="RbSens" Content="灵敏度" IsChecked="True" Margin="0,0,14,6"
                                     VerticalAlignment="Center" Checked="OnKind"/>
                        <RadioButton x:Name="RbGain" Content="增益" Margin="0,0,14,6"
                                     VerticalAlignment="Center" Checked="OnKind"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <TextBlock Text="横轴 DPI" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                                       ToolTip="只决定这张图的横轴怎么标：填成你鼠标的真实 DPI，图上的 in/s 才和手速对得上。它不影响鼠标本身，右边「输出 DPI」才影响。"/>
                            <TextBox x:Name="TxtChartDpi" Width="64" Margin="8,0,0,0" LostFocus="OnChartScale"
                                     ToolTip="只影响图表刻度和 cm/s 换算，不写进驱动。"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="轮询率" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                                       ToolTip="只用来把「每包位移」算给你看（比如 600 计数/秒 ÷ 1000Hz = 每包 0.6 个计数），不影响鼠标。"/>
                            <TextBox x:Name="TxtChartPoll" Width="76" Margin="8,0,0,0" LostFocus="OnChartScale"
                                     ToolTip="只影响图表和读数，不写进驱动。"/>
                        </StackPanel>
                    </WrapPanel>

                    <c:CurveChart x:Name="Chart" Grid.Row="1" Margin="0,4,0,4"/>

                    <TextBlock x:Name="CurveMeaning" Grid.Row="2" Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- full-height manual parameter panel -->
            <Border x:Name="ParamCard" Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="手动调整" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ParamPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
