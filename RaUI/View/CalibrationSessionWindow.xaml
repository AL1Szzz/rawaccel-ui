<Window x:Class="RaUI.View.CalibrationSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曲线盲测"
        Width="980" Height="720" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ChipOn" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#FF123A4D"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="曲线盲测" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- four steps, the active one lit -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,14">
            <Border x:Name="Step1" Style="{StaticResource ChipOn}">
                <TextBlock Text="01 转角确认" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
            </Border>
            <Border x:Name="Step2" Style="{StaticResource Chip}">
                <TextBlock Text="02 探索 25 轮" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            </Border>
            <Border x:Name="Step3" Style="{StaticResource Chip}">
                <TextBlock Text="03 决选 10 轮" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            </Border>
            <Border x:Name="Step4" Style="{StaticResource Chip}">
                <TextBlock Text="04 结果报告" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            </Border>
        </StackPanel>

        <!-- 01 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="IntroPanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="先确认你的手转得动多少度" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="IntroText" Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>

                    <Border Background="#FF232323" CornerRadius="4" Padding="14,10" Margin="0,14,0,0"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="开测前检查" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="关掉 Windows 的「提高指针精确度」；全程同一个 DPI、同一个坐姿、同一块鼠标垫；中途不要换鼠标。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TurnResult" Style="{StaticResource SubtleTextStyle}" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="全屏转半圈（180°）" MinWidth="180" MinHeight="34" Click="OnTurnCheck"/>
                        <Button Content="跳过，直接开测" Margin="10,0,0,0" MinHeight="34"
                                Style="{StaticResource AccentButton}" Click="OnSkipTurn"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 02 / 03 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="RoundCard" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="RoundTitle" Text="" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="RoundItem" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="RoundProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                 Background="#FF2B2B2B" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#FF111111" CornerRadius="4" Margin="0,14,0,0"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <TextBlock x:Name="RoundBig" Text="准备" FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="RoundNote" Style="{StaticResource SubtleTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="620"/>
                        </StackPanel>
                        <TextBlock x:Name="RoundLast" Grid.Row="1" Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="BtnRound" Content="开始本轮" MinWidth="150" MinHeight="36"
                            Style="{StaticResource AccentButton}" Click="OnNextRound"/>
                    <Button Content="放弃本次校准" Margin="10,0,0,0" MinHeight="36" Click="OnAbort"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 04 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="ReportCard" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="VerdictText" Text="" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictReasons" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ListView x:Name="ItemTable" Height="196" FontSize="12.5"
                                  Background="#FF1F1F1F" BorderBrush="#FF3D3D3D" BorderThickness="1">
                            <ListView.View>
                                <GridView x:Name="ItemGrid"/>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="候选的真实数值（测完才公开）" FontWeight="SemiBold" FontSize="13"
                                   Margin="0,14,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ItemsControl x:Name="RevealList" FontSize="12.5"/>

                        <TextBlock Text="这些结论有多可靠" FontWeight="SemiBold" FontSize="13"
                                   Margin="0,14,0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ItemsControl x:Name="CaveatList" FontSize="12.5"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="BtnApply" Content="用这条曲线" MinWidth="150" MinHeight="36"
                            Style="{StaticResource AccentButton}" Click="OnApply"/>
                    <Button Content="关闭" Margin="10,0,0,0" MinHeight="36" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusBar" Style="{StaticResource SubtleTextStyle}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
