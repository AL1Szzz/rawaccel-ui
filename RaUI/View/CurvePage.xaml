<UserControl x:Class="RaUI.View.CurvePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RaUI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="4,6,4,10">
            <TextBlock Text="曲线与参数" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock x:Name="Hint" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"
                       Text="这条曲线就是驱动实际执行的映射。单位是 counts/ms（DPI 归一化关闭时）；改成物理单位需在“设备”里填 DPI。"/>

            <!-- 现在用的曲线：一键切换，走和“写入驱动”同一套 校验→写→回读→退回 -->
            <WrapPanel x:Name="PresetBar" Margin="0,8,0,0"/>
            <TextBlock x:Name="LivePreset" Style="{StaticResource SubtleTextStyle}" Margin="0,5,0,0" Text=""/>
            <WrapPanel x:Name="PresetTools" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>

            <!-- chart -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbSens" Content="灵敏度" IsChecked="True" Margin="0,0,14,0" Checked="OnKind"/>
                        <RadioButton x:Name="RbGain" Content="增益" Margin="0,0,14,0" Checked="OnKind"/>
                        <CheckBox x:Name="ChkSamples" Content="实时手速" Margin="18,0,0,0" VerticalAlignment="Center"
                                  Click="OnSamples" ToolTip="用 WM_INPUT 采样你真实的手速分布，画在曲线底部"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                            <TextBlock Text="图表 DPI" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtChartDpi" Width="64" Margin="8,0,10,0" LostFocus="OnChartScale"/>
                            <TextBlock Text="轮询率" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtChartPoll" Width="76" Margin="8,0,0,0" LostFocus="OnChartScale"/>
                        </StackPanel>
                    </StackPanel>

                    <c:CurveChart x:Name="Chart" Grid.Row="1" Margin="0,10,0,4"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ChartNote" Style="{StaticResource SubtleTextStyle}" Text=""/>
                        <TextBlock x:Name="PhysicsNote" Style="{StaticResource SubtleTextStyle}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextTertiaryBrush}" Text=""/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- parameter panel: hidden by default, the chart is the point of this page -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel x:Name="Form"/>
                </Border>

                <Button x:Name="BtnParams" Grid.Row="1" Content="调整参数 ▾" HorizontalAlignment="Left"
                        Margin="2,0,0,8" Click="OnToggleParams"/>

                <Border x:Name="ParamCard" Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <StackPanel x:Name="ParamPanel"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
