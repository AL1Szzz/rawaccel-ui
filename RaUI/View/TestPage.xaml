<UserControl x:Class="RaUI.View.TestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,6,4,10">
            <TextBlock Text="瞄准测试" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0"
                       Text="点中小球练习手感，Esc 随时结束。"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="全屏测试" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="ModeInfo" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PlanInfo" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnStart" Content="开始全屏测试" Style="{StaticResource AccentButton}"
                                        MinWidth="168" MinHeight="36" Click="OnStart"/>
                                <Button Content="保持当前分辨率" Margin="10,0,0,0" Click="OnStartKeepMode"/>
                            </StackPanel>
                            <TextBlock x:Name="Summary" Style="{StaticResource SubtleTextStyle}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="结束后自动还原分辨率；若还原失败，状态栏会提示，可到 Windows 显示设置手动改回。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="训练场" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="九个项目，跟着上面的分辨率设置一起跑。成绩进下面的历史。"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="项目" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                           ToolTip="网格速击：同屏几个目标，点掉一个换个格子。六目标：六个固定位置，全清才算一组。跟枪：按住左键压住移动目标。"/>
                                <ComboBox x:Name="CmbDrill" Grid.Row="0" Grid.Column="1" Height="28" Margin="6,3,0,3">
                                    <ComboBoxItem Content="网格速击" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="六目标" Tag="1"/>
                                    <ComboBoxItem Content="人物跟枪" Tag="2"/>
                                    <ComboBoxItem Content="三目标" Tag="3"/>
                                    <ComboBoxItem Content="单球连击" Tag="4"/>
                                    <ComboBoxItem Content="反应单球" Tag="5"/>
                                    <ComboBoxItem Content="多目标连击" Tag="6"/>
                                    <ComboBoxItem Content="摆射训练" Tag="7"/>
                                    <ComboBoxItem Content="背闪复位" Tag="8"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="时长 秒" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtDrillSeconds" Grid.Row="1" Grid.Column="1" Text="60" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="2" Text="目标半径 px" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtDrillRadius" Grid.Row="2" Grid.Column="1" Text="22" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"
                                         ToolTip="跟枪有 34px 下限、摆射有 28px 下限：跟着一个 22px 的点满屏跑不叫跟枪。填更大的值不受影响。"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnDrill" Content="开始训练" Style="{StaticResource AccentButton}"
                                        MinWidth="140" MinHeight="36" Click="OnStartDrill"/>
                                <Button Content="保持当前分辨率" Margin="10,0,0,0" Click="OnStartDrillKeepMode"/>
                            </StackPanel>

                            <TextBlock x:Name="DrillSummary" Style="{StaticResource SubtleTextStyle}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="灵敏度校准" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="CalibInfo" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <Button Content="全屏转一圈（360°）" MinWidth="168" MinHeight="34" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="OnCalibrate"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="转盘由鼠标原始计数驱动，不经过 Windows 指针加速。转一圈看这段距离有多长，顺手也能反算灵敏度。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="曲线盲测" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="拿你当前这条曲线做基准，扫一个参数生成几档候选，五档轮流在五个项目上各打一轮，全程不告诉你数值；跑完再让领先档和原值单挑一次，最后给出结论和证据量。"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="扫描倍率（逗号分隔，须含 1.0）" VerticalAlignment="Center"
                                           FontSize="12.5" Margin="0,3"
                                           ToolTip="1.0 是你现在这条曲线。倍率作用于该模式的主参数：classic 是加速度，jump 是跳跃倍率，natural 是衰减率，synchronous 是 motivity，power 是 scale，lut 是查表幅度。两轴一起扫。"/>
                                <TextBox x:Name="TxtCalibMult" Grid.Row="0" Grid.Column="1" Text="0.5,1.0,1.5,2.0"
                                         MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>
                                <TextBlock Grid.Row="1" Text="盲测方式" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <ComboBox x:Name="CmbCalibPlan" Grid.Row="1" Grid.Column="1" Height="28" Margin="6,3,0,3"
                                          ToolTip="两轴同步：水平和垂直的同一个参数一起缩放。手腕流分轴：水平的起始阈值往后推（小幅定位保持 1:1，大幅度横移才吃加速），垂直的往前推（一点点下压就吃加速），两轴强度同时变。">
                                    <ComboBoxItem Content="两轴同步" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="手腕流分轴" Tag="1"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="总轮数（0 = 全跑，35 轮约 15 分钟）" VerticalAlignment="Center"
                                           FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtCalibRounds" Grid.Row="2" Grid.Column="1" Text="0"
                                         MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnCalibSession" Content="开始盲测" Style="{StaticResource AccentButton}"
                                        MinWidth="150" MinHeight="36" Click="OnStartCalibSession"/>
                                <CheckBox x:Name="ChkCalibNoAccel" Content="加一档无加速对照" IsChecked="True"
                                          VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12.5"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="CalibSessionInfo" Style="{StaticResource SubtleTextStyle}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Border x:Name="LastCalibCard" Margin="0,12,0,0" Padding="12,10"
                                    Background="#FF1C1C1C" BorderBrush="#FF3D3D3D" BorderThickness="1" CornerRadius="4"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="上次盲测" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtLastCalib" Style="{StaticResource SubtleTextStyle}"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button x:Name="BtnLastCalibPlan" Content="加入我的方案" MinHeight="32"
                                                Click="OnLastCalibPlan"
                                                ToolTip="把上次选出的曲线单独存一份，不动你现在这条。"/>
                                        <Button x:Name="BtnLastCalibApply" Content="设为当前曲线" MinHeight="32"
                                                Margin="10,0,0,0" Click="OnLastCalibApply"
                                                ToolTip="用上次选出的曲线替换当前这条（只改界面和文件，写进驱动还要去驱动页点应用）。"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="盲测期间会临时改驱动里的曲线，测完自动还原，不动 settings.json。中途退出、崩溃也会在关闭时还原；万一还原失败，状态栏会明确报警。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="成绩历史" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,6"
                                       Text="最近 80 次，新的在上面。"/>
                            <ListView x:Name="HistoryList" Height="204" FontSize="12.5"
                                      Background="#FF1F1F1F" BorderBrush="#FF3D3D3D" BorderThickness="1">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="130" DisplayMemberBinding="{Binding Time}"/>
                                        <GridViewColumn Header="项目" Width="104" DisplayMemberBinding="{Binding Mode}"/>
                                        <GridViewColumn Header="成绩" Width="190" DisplayMemberBinding="{Binding Score}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="测试设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="刷新距离 px" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                           ToolTip="球被点掉后，新位置离点击处的物理像素距离。"/>
                                <TextBox x:Name="TxtDistance" Grid.Row="0" Grid.Column="1" Text="420" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="1" Text="球半径 px" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtRadius" Grid.Row="1" Grid.Column="1" Text="26" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="2" Text="同屏球数" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <ComboBox x:Name="CmbBalls" Grid.Row="2" Grid.Column="1" Height="28" Margin="6,3,0,3">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3" IsSelected="True"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="12"/>
                                    <ComboBoxItem Content="16"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="计数方式" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                           ToolTip="按球数：点掉设定数量才结束，没点中不计数。限时：时间到后结束。"/>
                                <ComboBox x:Name="CmbMode" Grid.Row="3" Grid.Column="1" Height="28" Margin="6,3,0,3">
                                    <ComboBoxItem Content="按球数" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="限时" Tag="1"/>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Text="要点掉的球数" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtTrials" Grid.Row="4" Grid.Column="1" Text="30" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="5" Text="限时秒数" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtSeconds" Grid.Row="5" Grid.Column="1" Text="60" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="6" Text="方向" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <ComboBox x:Name="CmbDir" Grid.Row="6" Grid.Column="1" Height="28" Margin="6,3,0,3">
                                    <ComboBoxItem Content="全向" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="水平双向" Tag="5"/>
                                    <ComboBoxItem Content="仅向右" Tag="1"/>
                                    <ComboBoxItem Content="仅向左" Tag="2"/>
                                    <ComboBoxItem Content="仅向上" Tag="4"/>
                                    <ComboBoxItem Content="仅向下" Tag="3"/>
                                </ComboBox>

                                <TextBlock Grid.Row="7" Text="准星臂长 px" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtCrossArm" Grid.Row="7" Grid.Column="1" Text="9" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="8" Text="准星间隙 px" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <TextBox x:Name="TxtCrossGap" Grid.Row="8" Grid.Column="1" Text="3" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                <TextBlock Grid.Row="9" Text="准星颜色" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"/>
                                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="6,3,0,3">
                                    <ComboBox x:Name="CmbCrossColor" Height="28" Width="64">
                                        <ComboBoxItem Content="白" Tag="#FFFFFFFF" IsSelected="True"/>
                                        <ComboBoxItem Content="青" Tag="#FF4CC2FF"/>
                                        <ComboBoxItem Content="绿" Tag="#FF6CCB5F"/>
                                        <ComboBoxItem Content="红" Tag="#FFFF5B5B"/>
                                        <ComboBoxItem Content="黄" Tag="#FFFCE100"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkCrossDot" Content="点" Margin="8,0,0,0" VerticalAlignment="Center"
                                              IsChecked="True" ToolTip="臂长设 0 就只剩这个点"/>
                                </StackPanel>
                            </Grid>

                            <Expander Header="高级设置" Margin="0,12,0,0" IsExpanded="False">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="CS2 灵敏度" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                               ToolTip="保留灵敏度设置，本测试按像素摆球，不换算游戏角度。"/>
                                    <TextBox x:Name="TxtSens" Grid.Row="0" Grid.Column="1" Text="1.5" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                    <TextBlock Grid.Row="1" Text="随机种子" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                               ToolTip="相同种子和设置会使用相同的小球位置序列。"/>
                                    <TextBox x:Name="TxtSeed" Grid.Row="1" Grid.Column="1" Text="20261020" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"/>

                                    <TextBlock Grid.Row="2" Text="记录设备" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                               ToolTip="成绩里记下这只鼠标当前生效的方案；接了不止一只鼠标时才需要区分。"/>
                                    <ComboBox x:Name="CmbDevice" Grid.Row="2" Grid.Column="1" Height="28" Margin="6,3,0,3"/>

                                    <TextBlock Grid.Row="3" Text="鼠标真实 DPI" VerticalAlignment="Center" FontSize="12.5" Margin="0,3"
                                               ToolTip="只用来把成绩换算成 cm/s、°/s 和 cm/360。它不改鼠标手感 —— 手感由曲线页的「输出 DPI ÷ 设备 DPI」决定。"/>
                                    <TextBox x:Name="TxtDpi" Grid.Row="3" Grid.Column="1" Text="600" MinHeight="28" VerticalAlignment="Center" Margin="6,3,0,3"
                                             ToolTip="鼠标硬件/驱动里设的 DPI。填错只影响这里的物理量换算，不影响鼠标。"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
