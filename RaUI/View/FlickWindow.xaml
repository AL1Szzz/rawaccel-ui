<Window x:Class="RaUI.View.FlickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aim test"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Cursor="None"
        Background="#FF121212" KeyDown="OnKeyDown" Closed="OnClosed"
        MouseMove="OnPointerMove">
    <Grid>
        <Canvas x:Name="Surface" Background="Transparent" MouseDown="OnMouseDown"/>

        <!-- crosshair drawn at the real pointer hotspot; the system cursor is hidden -->
        <Canvas x:Name="CrossLayer" IsHitTestVisible="False">
            <Canvas x:Name="Cross" Width="0" Height="0">
                <Rectangle x:Name="CArmL" Height="2" RadiusX="1" RadiusY="1"/>
                <Rectangle x:Name="CArmR" Height="2" RadiusX="1" RadiusY="1"/>
                <Rectangle x:Name="CArmT" Width="2" RadiusX="1" RadiusY="1"/>
                <Rectangle x:Name="CArmB" Width="2" RadiusX="1" RadiusY="1"/>
                <Rectangle x:Name="CDot" Width="2" Height="2" RadiusX="1" RadiusY="1"/>
            </Canvas>
        </Canvas>

        <Border x:Name="Banner" Background="#B0000000" CornerRadius="4" Padding="12,6" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <TextBlock x:Name="BannerText" Text="" Foreground="#FFFFFFFF" FontSize="13"/>
        </Border>
    </Grid>
</Window>
