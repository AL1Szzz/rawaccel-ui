<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RaUI</AssemblyName>
    <RootNamespace>RaUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- raui.ico is generated by this very app (its dump-ico switch), because AppArt
         draws it: the exe icon, the window icon and the tray glyph can then never drift
         apart, and there is no opaque binary asset to hand-edit. -->
    <ApplicationIcon>raui.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Raw Accel Modern UI</Product>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- self-contained single file publish knobs are passed on the command line -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaCore\RaCore.csproj" />
  </ItemGroup>

</Project>
